{
  "name": "gloam",
  "private": true,
  "version": "0.1.0",
  "description": "Private stablecoin payments for people, teams and AI agents on Robinhood Chain, Tempo, Base and Ethereum (Elysium support coming). Private by default, provable on demand.",
  "scripts": {
    "dev": "pnpm --filter @gloam/app dev",
    "dev:app": "pnpm --filter @gloam/app dev",
    "build": "pnpm --filter @gloam/app build",
    "build:app": "pnpm --filter @gloam/app build",
    "sdk:build": "pnpm --filter @gloamtrade/sdk build",
    "sdk:test": "pnpm --filter @gloamtrade/sdk test",
    "mcp:build": "pnpm --filter @gloamtrade/mcp build",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "smoke": "pnpm --filter @gloam/app smoke",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.3"
}
